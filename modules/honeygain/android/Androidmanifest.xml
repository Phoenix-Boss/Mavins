<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml
  Location: modules/honeygain/android/src/main/AndroidManifest.xml

  This is the module-level manifest fragment merged into the host app's manifest
  by the Android build system. It declares all permissions, services, and receivers
  required by the Pawns SDK so the host app does NOT need to add them manually
  (in addition to or instead of the withPawns.js config plugin).

  Use EITHER this manifest fragment (library module approach) OR the withPawns.js
  config plugin — not both. If you are building a proper Expo module (library),
  use this file. If you are using an app-level config plugin, use withPawns.js.

  The <manifest> element has no package attribute here — the namespace is defined
  in build.gradle via the 'namespace' DSL property (expo.modules.mavin.honeygain).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ──────────────────────────────────────────────────── -->

    <!-- Required for SDK network operations -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required for the foreground service (Android 9 / API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      Required for foreground service type "specialUse" (Android 14 / API 34+).
      Google Play will ask for an explanation video during review.
      The explanation string is provided in the <property> element below.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Requested at runtime via requestBatteryOptimisation() — not granted at install time.
      Declares intent to show the system exemption dialog.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Required for PawnsBootReceiver to receive BOOT_COMPLETED -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Application declarations ─────────────────────────────────────── -->

    <application>

        <!--
          Foreground service used by the Pawns SDK.
          foregroundServiceType="specialUse" is required on Android 14 (API 34+).
          The <property> element supplies the mandatory explanation string for
          Google Play's specialUse review process.
        -->
        <service
            android:name="com.pawns.sdk.internal.service.PeerServiceForeground"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Allows to share internet traffic by modifying device's
                               network settings to be used as a gateway for internet
                               traffic." />
        </service>

        <!--
          Background service (only used if ServiceType.BACKGROUND is configured).
          Included here for completeness; the module defaults to FOREGROUND.
        -->
        <service
            android:name="com.pawns.sdk.internal.service.PeerServiceBackground"
            android:exported="false" />

        <!--
          Notification channel name displayed in Android Settings → App info → Notifications.
          The value is a literal string here; you may replace it with a @string/ reference
          if you have the key defined in your app's strings.xml.
        -->
        <meta-data
            android:name="com.pawns.sdk.pawns_service_channel_name"
            android:value="Bandwidth Sharing" />

        <!--
          Boot-complete receiver.
          Restarts bandwidth sharing after device reboot if consent was previously given.
          android:exported="false" — system broadcasts are still delivered even when
          exported is false on Android 9+.
        -->
        <receiver
            android:name="expo.modules.mavin.honeygain.PawnsBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>