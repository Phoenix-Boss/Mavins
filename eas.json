{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON"
      },
      "prebuild": "echo $GOOGLE_SERVICES_JSON | base64 -d > google-services.json"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON"
      },
      "prebuild": "echo $GOOGLE_SERVICES_JSON | base64 -d > google-services.json"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON"
      },
      "prebuild": "echo $GOOGLE_SERVICES_JSON | base64 -d > google-services.json"
    }
  },
  "submit": {
    "production": {}
  }
}