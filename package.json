{
    "name": "mavinsplayer",
    "main": "expo-router/entry",
    "version": "1.10.0",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "lint": "expo lint",
        "doctor": "npx expo-doctor@latest",
        "build": "eas build --platform android --profile preview --local",
        "build-dev": "eas build --platform android --profile development --local",
        "build-eas": "eas build --platform android --profile preview",
        "build-dev-eas": "eas build --platform android --profile development",
        "format": "npx prettier@latest --write .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
        "test:clear": "jest --clearCache",
        "ios": "expo run:ios",
        "postinstall": "patch-package && node scripts/fix-bom.js"
    },
    "dependencies": {
        "@animatereactnative/marquee": "^0.5.2",
        "@expo/metro-runtime": "~6.1.2",
        "@expo/vector-icons": "^15.1.1",
        "@preeternal/react-native-cookie-manager": "^6.3.0",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-native-community/netinfo": "^11.4.1",
        "@react-native-community/slider": "5.0.1",
        "@react-navigation/bottom-tabs": "^7.4.0",
        "@react-navigation/elements": "^2.8.4",
        "@react-navigation/native": "^7.1.8",
        "@reduxjs/toolkit": "^2.11.2",
        "@shopify/flash-list": "2.0.2",
        "@supabase/supabase-js": "^2.95.3",
        "@tanstack/react-query": "^5.90.21",
        "axios": "^1.13.5",
        "babel-plugin-dotenv-import": "^3.0.1",
        "base-64": "^1.0.0",
        "color": "^5.0.3",
        "event-target-polyfill": "^0.0.4",
        "expo": "~54.0.29",
        "expo-application": "~7.0.8",
        "expo-av": "^16.0.8",
        "expo-blur": "^15.0.8",
        "expo-build-properties": "~1.0.10",
        "expo-constants": "~18.0.13",
        "expo-crypto": "~15.0.8",
        "expo-dev-client": "~6.0.20",
        "expo-device": "~8.0.10",
        "expo-document-picker": "~14.0.8",
        "expo-file-system": "~19.0.21",
        "expo-font": "^14.0.9",
        "expo-haptics": "~15.0.8",
        "expo-image": "~3.0.11",
        "expo-keep-awake": "~15.0.7",
        "expo-linear-gradient": "~15.0.8",
        "expo-linking": "~8.0.10",
        "expo-media-library": "^55.0.10",
        "expo-navigation-bar": "^5.0.10",
        "expo-network": "~8.0.8",
        "expo-notifications": "~0.32.15",
        "expo-router": "~6.0.19",
        "expo-secure-store": "~15.0.8",
        "expo-sharing": "~14.0.8",
        "expo-splash-screen": "~31.0.12",
        "expo-sqlite": "~16.0.10",
        "expo-status-bar": "^55.0.4",
        "expo-system-ui": "~6.0.9",
        "expo-updates": "^29.0.16",
        "expo-video": "^55.0.11",
        "firebase": "^12.7.0",
        "honeygain-sdk": "file:./modules/honeygain",
        "lrclib-api": "^2.0.4",
        "mavin-engine": "file:./modules/mavin-engine",
        "mavin-eq": "file:./modules/mavin-eq",
        "mavin-player": "file:./modules/mavin-player",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "0.81.5",
        "react-native-awesome-slider": "^2.9.0",
        "react-native-device-info": "^15.0.1",
        "react-native-edge-to-edge": "1.6.0",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-image-colors": "^2.5.1",
        "react-native-loader-kit": "^3.0.0",
        "react-native-mmkv": "^3.3.3",
        "react-native-paper": "^5.14.5",
        "react-native-reanimated": "~4.1.1",
        "react-native-safe-area-context": "^5.6.2",
        "react-native-screens": "~4.16.0",
        "react-native-size-matters": "^0.4.2",
        "react-native-svg": "15.12.1",
        "react-native-track-player": "file:./modules/mavin-player",
        "react-native-url-polyfill": "^3.0.0",
        "react-native-worklets": "0.5.1",
        "react-redux": "^9.2.0",
        "soundcloud-key-fetch": "^1.0.13",
        "text-encoding-polyfill": "^0.6.7",
        "ts-pattern": "^5.9.0",
        "web-streams-polyfill": "^4.2.0",
        "youtubei.js": "^16.0.1",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@babel/plugin-syntax-import-attributes": "^7.27.1",
        "@babel/plugin-transform-export-namespace-from": "^7.27.1",
        "@types/base-64": "^1.0.2",
        "@types/color": "^4.2.0",
        "@types/jest": "29.5.14",
        "@types/node": "^20.11.0",
        "@types/react": "~19.1.10",
        "babel-jest": "^30.0.0",
        "dotenv": "^17.3.1",
        "eslint": "^9.39.1",
        "eslint-config-expo": "~10.0.0",
        "eslint-plugin-expo": "^0.1.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "expo-atlas": "^0.4.3",
        "jest": "~29.7.0",
        "jest-expo": "^54.0.0",
        "patch-package": "^8.0.1",
        "ts-node": "^10.9.0",
        "typescript": "~5.9.2"
    },
    "jest": {
        "preset": "jest-expo",
        "setupFilesAfterEnv": [
            "<rootDir>/tests/setup.ts"
        ],
        "testMatch": [
            "**/tests/**/*.test.ts",
            "**/tests/**/*.test.tsx"
        ],
        "transformIgnorePatterns": [
            "node_modules/(?!(jest-)?react-native|@react-native|@react-native-community|@react-navigation|@preeternal|expo(nent)?|@expo(nent)?/.*|@expo-vector-icons|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@shopify/flash-list|react-native-iphone-x-helper|react-native-awesome-slider|react-native-track-player|react-native-reanimated|react-native-gesture-handler|react-native-safe-area-context|react-native-screens|react-native-paper|react-native-vector-icons|react-native-size-matters|react-native-image-colors|react-native-blurhash|@miblanchard/react-native-slider|react-native-keyboard-aware-scroll-view|react-native-webview|react-native-blob-util|react-native-pdf|react-native-fs|@preeternal/react-native-cookie-manager|react-native-cookies|react-native-device-info|react-native-mmkv|react-native-worklets|react-native-url-polyfill|react-native-track-player|react-native-awesome-slider|react-native-image-colors|react-native-loader-kit|@react-native-community/netinfo|@react-native-community/slider|@shopify/flash-list|@tanstack/react-query|@reduxjs/toolkit|@supabase/supabase-js|firebase|youtubei.js|lrclib-api|mavin-engine|mavin-eq|mavin-player|honeygain-sdk)"
        ],
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "jsx",
            "json",
            "node"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1",
            "^../libs/cache$": "<rootDir>/libs/cache/index.ts",
            "^.+\\\\.(css|less|scss|sass)$": "identity-obj-proxy",
            "^mavin-eq$": "<rootDir>/modules/mavin-eq/index.ts"
        },
        "transform": {
            "^.+\\\\.(js|jsx|ts|tsx)$": "babel-jest"
        },
        "testPathIgnorePatterns": [
            "\\\\.snap$",
            "\\\\.mock\\\\.[jt]sx?$",
            "/node_modules/",
            "/android/",
            "/ios/"
        ],
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "libs/**/*.{ts,tsx}",
            "!**/node_modules/**",
            "!**/vendor/**",
            "!**/__tests__/**",
            "!**/*.d.ts"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 50,
                "functions": 50,
                "lines": 50,
                "statements": 50
            }
        },
        "globals": {
            "__DEV__": true
        },
        "verbose": true,
        "bail": 1,
        "maxWorkers": "50%"
    },
    "private": true,
    "expo": {
        "autolinking": {
            "searchPaths": [
                "./modules"
            ]
        },
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": [
                    "react-native-track-player",
                    "react-native-cookies",
                    "react-native-awesome-slider",
                    "react-native-device-info",
                    "react-native-mmkv",
                    "react-native-paper",
                    "react-native-reanimated",
                    "react-native-safe-area-context",
                    "react-native-screens",
                    "react-native-gesture-handler",
                    "react-native-image-colors",
                    "react-native-loader-kit",
                    "react-native-size-matters",
                    "react-native-worklets",
                    "@react-native-community/netinfo",
                    "@react-native-community/slider",
                    "@shopify/flash-list",
                    "honeygain-sdk",
                    "mavin-eq"
                ],
                "listUnknownPackages": false
            }
        },
        "cspell": {
            "words": [
                "Honeygain",
                "honeygain",
                "hgsdk",
                "HgSdk",
                "optIn",
                "optOut",
                "launchOnBoot",
                "Mavins",
                "mavins",
                "mexexiy",
                "mmkv",
                "MMKV",
                "reanimated",
                "supabase",
                "Supabase",
                "lrclib",
                "youtubei",
                "mavin",
                "autoeq",
                "AutoEQ",
                "biquad"
            ]
        }
    }
}
